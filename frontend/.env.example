# ======================================================
# GT-Vision Frontend - Environment Variables
# ======================================================

# API Base URL (usado em produção)
VITE_API_URL=http://localhost:8000

# Streaming Service URL
VITE_STREAMING_URL=http://localhost:8001

# HLS/MediaMTX URL
VITE_HLS_URL=http://localhost:8888

# MediaMTX Playback Server URL
VITE_PLAYBACK_URL=http://localhost:9996

# WebSocket URL
VITE_WS_URL=ws://localhost:8001

# RTMP Server (para modo fácil de adicionar câmeras)
# Formato: host:porta
VITE_RTMP_SERVER=localhost:1935

VITE_GOOGLE_MAPS_API_KEY=
