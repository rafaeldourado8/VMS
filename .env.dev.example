# ======================================================
# === DEVELOPMENT ENVIRONMENT - VMS
# ======================================================

# ======================================================
# === 1. DJANGO SETTINGS
# ======================================================
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.compute.amazonaws.com

# Security (Relaxed for Dev)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ======================================================
# === 2. DATABASE (RDS DEV)
# ======================================================
DB_HOST=vms-dev-postgres.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
POSTGRES_DB=gtvision_db
POSTGRES_USER=gtvision_user
POSTGRES_PASSWORD=CHANGE_ME_DEV_PASSWORD

# No replicas in dev
DB_HOST_READERS=vms-dev-postgres.xxxxxx.us-east-1.rds.amazonaws.com

# ======================================================
# === 3. REDIS (ELASTICACHE DEV)
# ======================================================
REDIS_HOST=vms-dev-redis.xxxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_URL=redis://vms-dev-redis.xxxxxx.cache.amazonaws.com:6379/0
REDIS_SSL=False

# ======================================================
# === 4. AWS SERVICES
# ======================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# S3 Storage
AWS_STORAGE_BUCKET_NAME=vms-dev-recordings
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# ======================================================
# === 5. CORS (Permissive for Dev)
# ======================================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1
CORS_ALLOW_CREDENTIALS=True

# ======================================================
# === 6. AUTHENTICATION
# ======================================================
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=30

# ======================================================
# === 7. API KEYS
# ======================================================
INGEST_API_KEY=dev-ingest-api-key
MEDIAMTX_API_USER=dev_user
MEDIAMTX_API_PASS=dev_password

# RabbitMQ
RABBITMQ_USER=dev_user
RABBITMQ_PASS=dev_password
RABBITMQ_VHOST=/

# ======================================================
# === 8. MONITORING
# ======================================================
LOG_LEVEL=DEBUG
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/ecs/vms-dev
CLOUDWATCH_LOG_STREAM=backend

# ======================================================
# === 9. SERVICES URLS
# ======================================================
BASE_URL=http://vms-dev-alb-xxxxxx.us-east-1.elb.amazonaws.com
MEDIAMTX_API_URL=http://mediamtx:9997
VOD_SERVICE_URL=http://vod_hls:8004

# ======================================================
# === 10. FEATURE FLAGS (Dev)
# ======================================================
ENABLE_API_DOCS=True
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SILK_PROFILER=True
MAINTENANCE_MODE=False

# ======================================================
# === 11. RATE LIMITING (Relaxed)
# ======================================================
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_HOUR=10000

# ======================================================
# NOTES:
# ======================================================
# 1. This is for AWS DEV environment (auto on/off 7h-18h MS)
# 2. Security is relaxed for development
# 3. Get endpoints from: terraform output (in terraform/dev/)
# 4. Auto shutdown saves ~$23/month
