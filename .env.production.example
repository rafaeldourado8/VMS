# =====================================================
# SEGURANÇA - PRODUÇÃO
# =====================================================

# CORS - Domínio do frontend em produção
CORS_ORIGIN=https://seudominio.com

# HAProxy Stats - Senha para acessar estatísticas
HAPROXY_STATS_PASSWORD=senha_forte_aqui

# =====================================================
# BANCO DE DADOS
# =====================================================
POSTGRES_USER=gtvision_user
POSTGRES_PASSWORD=sua_senha_forte_aqui
POSTGRES_DB=gtvision_db

# =====================================================
# RABBITMQ
# =====================================================
RABBITMQ_USER=gtvision_user
RABBITMQ_PASS=sua_senha_rabbitmq_aqui

# =====================================================
# MEDIAMTX
# =====================================================
MEDIAMTX_API_USER=mediamtx_api_user
MEDIAMTX_API_PASS=sua_senha_mediamtx_aqui

# =====================================================
# DJANGO
# =====================================================
SECRET_KEY=sua_secret_key_django_aqui
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# =====================================================
# LOG LEVEL
# =====================================================
LOG_LEVEL=INFO
