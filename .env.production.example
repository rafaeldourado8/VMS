# ======================================================
# === PRODUCTION ENVIRONMENT - VMS
# ======================================================

# ======================================================
# === 1. DJANGO SECURITY (OWASP)
# ======================================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe_50
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-alb-dns.amazonaws.com

# HTTPS/SSL Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ======================================================
# === 2. DATABASE (RDS PRODUCTION)
# ======================================================
# Primary (Write)
DB_HOST=vms-prod-postgres.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
POSTGRES_DB=gtvision_db
POSTGRES_USER=gtvision_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN

# Read Replicas
DB_HOST_REPLICA_1=vms-prod-postgres-replica-1.xxxxxx.us-east-1.rds.amazonaws.com
DB_HOST_REPLICA_2=vms-prod-postgres-replica-2.xxxxxx.us-east-1.rds.amazonaws.com
DB_HOST_READERS=replica1.amazonaws.com,replica2.amazonaws.com

# SSL/TLS for Database
DB_SSL_MODE=require
DB_SSL_CERT=/app/certs/rds-ca-bundle.pem

# ======================================================
# === 3. REDIS (ELASTICACHE PRODUCTION)
# ======================================================
REDIS_HOST=vms-prod-redis.xxxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_URL=rediss://vms-prod-redis.xxxxxx.cache.amazonaws.com:6379/0
REDIS_SSL=True
REDIS_PASSWORD=CHANGE_ME_REDIS_AUTH_TOKEN

# ======================================================
# === 4. AWS SERVICES
# ======================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# S3 Storage
AWS_STORAGE_BUCKET_NAME=vms-prod-recordings
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.your-domain.com
AWS_S3_USE_SSL=True

# CloudFront
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net
CLOUDFRONT_KEY_ID=CHANGE_ME_CLOUDFRONT_KEY_ID
CLOUDFRONT_PRIVATE_KEY_PATH=/app/certs/cloudfront-private-key.pem

# ======================================================
# === 5. SSL/TLS CERTIFICATES
# ======================================================
SSL_CERTIFICATE_PATH=/app/certs/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/app/certs/privkey.pem
SSL_CA_BUNDLE_PATH=/app/certs/ca-bundle.pem

# ACM Certificate ARN (for ALB)
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx

# ======================================================
# === 6. SECURITY HEADERS & OWASP
# ======================================================
# CORS (Strict for Production)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRFToken

# CSP (Content Security Policy)
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' https://cdn.your-domain.com
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https://cdn.your-domain.com
CSP_CONNECT_SRC='self' wss://your-domain.com
CSP_FRAME_ANCESTORS='none'

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ======================================================
# === 7. AUTHENTICATION & JWT
# ======================================================
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Session Security
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_AGE=3600

# ======================================================
# === 8. API KEYS & SECRETS
# ======================================================
INGEST_API_KEY=CHANGE_ME_GENERATE_UUID4
MEDIAMTX_API_USER=CHANGE_ME_MEDIAMTX_USER
MEDIAMTX_API_PASS=CHANGE_ME_STRONG_PASSWORD

# RabbitMQ
RABBITMQ_USER=CHANGE_ME_RABBITMQ_USER
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_VHOST=/
RABBITMQ_SSL=True

# ======================================================
# === 9. MONITORING & LOGGING
# ======================================================
LOG_LEVEL=WARNING
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/ecs/vms-prod
CLOUDWATCH_LOG_STREAM=backend

# ======================================================
# === 10. SERVICES URLS
# ======================================================
BASE_URL=https://your-domain.com
MEDIAMTX_API_URL=https://mediamtx.your-domain.com
VOD_SERVICE_URL=https://vod.your-domain.com

# ======================================================
# === 11. BACKUP & DISASTER RECOVERY
# ======================================================
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=vms-prod-backups

# ======================================================
# === 12. FEATURE FLAGS
# ======================================================
ENABLE_API_DOCS=False
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILER=False
MAINTENANCE_MODE=False

# ======================================================
# === 13. OWASP SECURITY SETTINGS
# ======================================================
# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800
PASSWORD_RESET_TIMEOUT=3600

# File Upload Security
MAX_UPLOAD_SIZE=104857600
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,mp4,avi
SCAN_UPLOADS_FOR_MALWARE=True

# SQL Injection Protection (Django ORM handles this)
USE_PARAMETERIZED_QUERIES=True

# XSS Protection
ESCAPE_HTML_IN_JSON=True
SANITIZE_USER_INPUT=True

# ======================================================
# === 14. WAF & DDOS PROTECTION
# ======================================================
WAF_ENABLED=True
WAF_WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789012:global/webacl/vms-prod/xxxxxxxx

# Shield Advanced
SHIELD_ADVANCED_ENABLED=True

# ======================================================
# === 15. COMPLIANCE
# ======================================================
GDPR_ENABLED=True
DATA_RETENTION_DAYS=365
AUDIT_LOG_ENABLED=True
ENCRYPT_PII=True

# ======================================================
# NOTES:
# ======================================================
# 1. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
# 2. Generate JWT_SECRET_KEY: openssl rand -base64 64
# 3. Use AWS Secrets Manager for sensitive values in production
# 4. Enable AWS WAF for OWASP Top 10 protection
# 5. Use ACM for SSL certificates (free with AWS)
# 6. Enable CloudWatch Logs for audit trail
# 7. Configure AWS Shield for DDoS protection
# 8. Use AWS Systems Manager Parameter Store for secrets rotation
# 9. Enable MFA for all admin accounts
# 10. Regular security audits with AWS Inspector
